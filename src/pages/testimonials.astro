---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';

const title = 'Testimonials & Client Feedback';
const description =
  'Testimonials from principals, organizers, and audiences who have experienced Carlin Nordstrom as a keynote speaker and workshop facilitator.';

const allTestimonials = (await getCollection('testimonials'))
  .filter((t) => !t.data.quote.startsWith('[PLACEHOLDER'))
  .sort((a, b) => a.data.order - b.data.order);

const testimonials = allTestimonials.filter((t) => t.data.role !== 'Google Review');
const googleTestimonials = allTestimonials.filter((t) => t.data.role === 'Google Review');
---

<Layout title={title} description={description}>
  <section class="bg-ink-900 text-cream-50">
    <div class="container-content py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-400 mb-4">
        Client Testimonial & Student Impact
      </p>
      <h1 class="text-display-lg font-semibold text-cream-50 text-balance">
        Testimonials &amp; Client Feedback
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl text-pretty leading-relaxed">
        Carlin has delivered keynotes, workshops, and youth programs for schools, First Nations communities, organizations, and conferences across Canada. Here's feedback from event organizers and participants.
      </p>
    </div>
  </section>

  <!-- Testimonial cards -->
  <section class="container-content py-24 md:py-32">
    <SectionHeading
      eyebrow="Schools & Education"
      title="What People Are Saying"
      align="center"
      class="reveal mb-16"
    />
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <div class="reveal rounded-2xl border border-ink-100 bg-cream-50 p-8">
          <svg class="w-8 h-8 text-ember-300 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-ink-500 leading-relaxed italic">
            {t.data.quote}
          </p>
          <div class="mt-6 pt-6 border-t border-ink-100">
            <p class="font-semibold text-ink-900">{t.data.author}</p>
            <p class="text-sm text-ink-400">{t.data.role}{t.data.role && t.data.organization ? ' · ' : ''}{t.data.organization}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  {googleTestimonials.length > 0 && (
    <section class="bg-ink-900 py-24 text-cream-50 md:py-32">
      <div class="container-content">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-400">More Feedback</p>
          <h2 class="mt-4 text-display-md font-semibold text-cream-50">Google Reviews</h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {googleTestimonials.map((review) => (
            <article class="reveal rounded-2xl border border-ink-700 bg-ink-800 p-7">
              <p class="text-ink-100 leading-relaxed">{review.data.quote}</p>
              <div class="mt-6 border-t border-ink-700 pt-5">
                <p class="font-semibold text-cream-50">{review.data.author}</p>
                <p class="mt-1 text-sm text-ink-300">Google Review</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABanner
    title="Planning an Event for Your School, Community, or Organization?"
    subtitle="See how Carlin can tailor a keynote or workshop to your audience and goals."
    label="Request Booking Information"
    showOneSheet
  />
</Layout>

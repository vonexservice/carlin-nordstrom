---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const canonical = `/blog/${post.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
    author: { '@type': 'Person', name: post.data.author, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(canonical, site.url).href },
  },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  type="article"
  jsonLd={jsonLd}
>
  <article class="container-content py-24 md:py-32 max-w-3xl">
    <a href="/blog" class="text-sm font-semibold text-ember-600 hover:text-ember-700 transition-colors">
      &larr; Back to Blog
    </a>

    {post.data.tags.length > 0 && (
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.15em] text-ember-600">
        {post.data.tags[0]}
      </p>
    )}

    <h1 class="mt-3 text-display-md font-semibold text-ink-900 text-balance">
      {post.data.title}
    </h1>

    <p class="mt-4 text-lg text-ink-500 leading-relaxed">
      {post.data.description}
    </p>

    <div class="mt-12 prose prose-lg max-w-none prose-headings:font-display prose-headings:text-ink-900 prose-a:text-ember-600">
      <Content />
    </div>
  </article>
</Layout>

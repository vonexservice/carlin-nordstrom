---
export interface SectionHeadingProps {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  light?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  as: Tag = 'h2',
  light = false,
  class: className = '',
} = Astro.props as SectionHeadingProps;

const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
const eyebrowColor = light ? 'text-ember-400' : 'text-ember-600';
const titleColor = light ? 'text-cream-50' : 'text-ink-900';
const subtitleColor = light ? 'text-ink-300' : 'text-ink-500';
---

<div class={`flex flex-col gap-3 ${alignClass} ${className}`}>
  {eyebrow && (
    <span class={`text-sm font-semibold uppercase tracking-[0.15em] ${eyebrowColor}`}>
      {eyebrow}
    </span>
  )}
  <Tag class={`text-display-sm font-semibold text-balance ${titleColor}`}>
    {title}
  </Tag>
  {subtitle && (
    <p class={`text-lg max-w-2xl text-pretty leading-relaxed ${subtitleColor}`}>
      {subtitle}
    </p>
  )}
</div>

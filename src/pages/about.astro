---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
import { getCollection } from 'astro:content';

const title = 'About Carlin Nordstrom';
const description =
  'Carlin Nordstrom is a Saskatchewan-based Indigenous keynote speaker, former professional hockey player, and founder of Kisik Youth Wellness and Kisik Pathways to Success.';

const timeline = [
  {
    heading: 'Grew up playing hockey in Warman, Saskatchewan',
    text: 'Carlin faced racism as the only First Nations player on his team, an experience that shaped his commitment to resilience and leadership.',
  },
  {
    heading: 'Earned an NCAA Division I scholarship',
    text: 'He played at Western Michigan University and served as assistant captain.',
  },
  {
    heading: 'Played professional hockey',
    text: 'His career included two games with the Ottawa Senators.',
  },
  {
    heading: 'Built youth and community programs',
    text: 'Carlin founded Kisik Youth Wellness and Kisik Pathways to Success, supporting youth leadership, wellness, and career development.',
  },
  {
    heading: 'Speaks across Canada',
    text: 'He delivers keynotes and workshops for schools, First Nations communities, corporations, and conferences.',
  },
];

const audienceOutcomes = [
  { title: 'Belief', text: 'Confidence to set goals and take ownership of the path forward.' },
  { title: 'Resilience', text: 'Tools for working through setbacks instead of being stopped by them.' },
  { title: 'Leadership', text: 'What it means to lead by example, on a team or in an organization.' },
  { title: 'Perseverance', text: 'How to keep moving when circumstances don\'t go as planned.' },
];

const testimonials = await getCollection('testimonials', ({ data }) => !data.quote.startsWith('[PLACEHOLDER'));
const featured = testimonials.find((t) => t.data.organization === 'J.A. Williams High School') ?? testimonials[0];
---

<Layout title={title} description={description}>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-ink-900 text-cream-50">
    <div class="container-content relative grid min-h-[480px] items-center gap-8 py-16 md:grid-cols-[1.05fr_0.95fr] md:py-20">
      <div class="relative z-10 max-w-2xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-ember-400">
          Indigenous Keynote Speaker, Former Professional Hockey Player &amp; Youth Mentor
        </p>
        <h1 class="text-display-lg font-semibold text-cream-50 text-balance">Carlin Nordstrom</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-300 leading-relaxed text-pretty">
          Carlin helps students, communities, and workplace teams build belief, resilience, and leadership through the lessons of his lived experience.
        </p>
        <div class="mt-8">
          <Button href={site.bookingHref} variant="primary" size="lg">Check Speaking Availability</Button>
        </div>
      </div>
      <div class="relative flex min-h-[320px] items-end justify-center self-end md:min-h-[480px]">
        <img src="/images/carlin-arms-crossed.png" alt="Carlin Nordstrom standing with his arms crossed" width="1515" height="2055" loading="eager" fetchpriority="high" class="relative z-10 max-h-[440px] w-auto object-contain object-bottom md:max-h-[500px]" />
      </div>
    </div>
  </section>

  <!-- 2. Short intro -->
  <section class="container-content py-20 md:py-24">
    <div class="mx-auto max-w-3xl reveal">
      <p class="text-lg text-ink-600 leading-relaxed text-pretty">
        Carlin Nordstrom is a Saskatchewan-based Indigenous keynote speaker and founder of Kisik Youth Wellness and Kisik Pathways to Success. A member of Poundmaker First Nation, he draws on his journey through minor hockey, NCAA Division I hockey, and professional hockey to speak about perseverance, identity, leadership, and achieving goals.
      </p>
      <p class="mt-4 text-lg text-ink-600 leading-relaxed text-pretty">
        Carlin speaks to schools, First Nations communities, youth organizations, corporations, conferences, and community events across Canada.
      </p>
    </div>
  </section>

  <!-- 3. Speaking reel -->
  <section class="bg-ink-900 py-16 md:py-20">
    <div class="container-content">
      <div class="reveal mx-auto max-w-3xl overflow-hidden rounded-2xl shadow-2xl">
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/W_XS4l5xu94"
            title="Carlin Nordstrom speaking reel"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Career journey timeline -->
  <section class="bg-cream-200 py-24 md:py-32">
    <div class="container-content">
      <SectionHeading eyebrow="Career Journey" title="From Saskatchewan to the Ottawa Senators" align="center" class="reveal mb-16" />
      <div class="mx-auto flex max-w-3xl flex-col gap-10">
        {timeline.map((item, i) => (
          <div class="reveal flex gap-6 items-start">
            <div class="flex-shrink-0 flex items-center justify-center w-11 h-11 rounded-full bg-ember-600 text-cream-50 font-display text-lg font-semibold">
              {i + 1}
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-ink-900 mb-1.5">{item.heading}</h3>
              <p class="text-ink-500 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. What audiences get -->
  <section class="container-content py-24 md:py-32">
    <SectionHeading eyebrow="What Audiences Get" title="A practical message, not just a story" align="center" class="reveal mb-14" />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {audienceOutcomes.map((item) => (
        <article class="reveal rounded-2xl border border-ink-200 bg-cream-50 p-7">
          <h2 class="text-xl font-semibold text-ink-900">{item.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 6. Speaking experience & credibility -->
  <section class="bg-ink-900 py-24 text-cream-50 md:py-32">
    <div class="container-content">
      <SectionHeading eyebrow="Speaking Experience" title="A decade of presentations across Canada" light align="center" class="reveal mb-14" />
      <div class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
        <div class="reveal">
          <p class="text-display-sm font-semibold text-ember-400">10+</p>
          <p class="mt-2 text-sm text-ink-300">Years of Motivational Speaking Experience</p>
        </div>
        <div class="reveal">
          <p class="text-display-sm font-semibold text-ember-400">5</p>
          <p class="mt-2 text-sm text-ink-300">Provinces Presented Across</p>
        </div>
        <div class="reveal">
          <p class="text-display-sm font-semibold text-ember-400">10</p>
          <p class="mt-2 text-sm text-ink-300">Years of Kisik Youth Wellness Camps</p>
        </div>
        <div class="reveal">
          <p class="text-display-sm font-semibold text-ember-400">Yr 5</p>
          <p class="mt-2 text-sm text-ink-300">Kisik Pathways to Success</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Testimonial -->
  {featured && (
    <section class="container-content py-24 md:py-32">
      <div class="mx-auto max-w-3xl reveal text-center">
        <p class="text-xl leading-relaxed text-ink-700 text-pretty">"{featured.data.quote}"</p>
        <p class="mt-6 font-semibold text-ink-900">
          {featured.data.author}{featured.data.role ? `, ${featured.data.role}` : ''}{featured.data.organization ? ` — ${featured.data.organization}` : ''}
        </p>
      </div>
    </section>
  )}

  <!-- 8. Closing CTA -->
  <CTABanner
    title="Book Carlin for Your Next Event"
    subtitle="Bring a practical, inspiring message on belief, resilience, leadership, and moving forward. Carlin speaks across Canada and offers keynotes, workshops, and virtual presentations."
    label="Check Speaking Availability"
  />
</Layout>

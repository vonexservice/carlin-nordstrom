---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import CTABanner from '../components/CTABanner.astro';
import Button from '../components/Button.astro';

const title = 'Contact';
const description =
  'Book Carlin Nordstrom as a keynote speaker or workshop facilitator. Get in touch for speaking engagements, corporate events, and youth programs.';

const faqs = [
  {
    question: 'How do I book Carlin Nordstrom for a keynote or workshop?',
    answer:
      "Submit an inquiry through the contact form on this page or call directly. Carlin's team will discuss your event goals, audience, theme, and date, then customize a presentation to fit your organization before confirming the booking.",
  },
  {
    question: 'What regions does Carlin speak in?',
    answer:
      'Carlin is based in Saskatchewan and speaks to schools, communities, and organizations across Western and Central Canada, including Saskatchewan, Alberta, Manitoba, British Columbia, and Ontario.',
  },
  {
    question: 'What topics does Carlin speak about?',
    answer:
      'Carlin’s keynotes cover Indigenous leadership, overcoming adversity, resilience, and corporate leadership, drawing on his experience as a professional hockey player and founder of Kisik Youth Wellness and Kisik Pathways to Success.',
  },
  {
    question: 'Does Carlin offer workshops for schools and youth, not just corporate keynotes?',
    answer:
      'Yes. Carlin offers interactive workshops — including Health & Wellness, Lateral Violence, Warrior Spirit, and the RISE UP Mental Health, Prevention and Fitness Program — designed specifically for schools, First Nations communities, and youth organizations.',
  },
  {
    question: 'Is Carlin available for corporate events as well as schools and communities?',
    answer:
      'Yes. Carlin speaks to corporate organizations, leadership teams, conferences, and industry associations, as well as schools, First Nations organizations, and community groups.',
  },
  {
    question: 'How far in advance should we book?',
    answer:
      'Book as early as possible to secure your preferred date, especially for keynotes and workshops during the school year.',
  },
];

const faqJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<Layout title={title} description={description} jsonLd={faqJsonLd}>
  <section class="bg-ink-900 text-cream-50">
    <div class="container-content py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-400 mb-4">
        Get in Touch
      </p>
      <h1 class="text-display-lg font-semibold text-cream-50 text-balance">
        Have Questions? Let's Talk
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl text-pretty leading-relaxed">
        We're Always Ready
      </p>
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <!-- Contact info -->
      <div class="reveal">
        <h2 class="text-display-md font-semibold text-ink-900 mb-6">
          Get in Touch
        </h2>
        <p class="text-ink-600 leading-relaxed text-pretty mb-8">
          If your agency, company, or community wants to book Carlin for his inspiring motivational speeches or workshops, please get in touch by filling out the contact form or calling directly.
        </p>

        <div class="space-y-6">
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-ember-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-ember-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-ink-400">Phone</p>
              <a href={`tel:${site.phone}`} class="text-lg font-semibold text-ink-900 hover:text-ember-700 transition-colors">
                {site.phoneDisplay}
              </a>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-ember-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-ember-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-ink-400">Email</p>
              <p class="text-lg font-semibold text-ink-900">{site.email}</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-ember-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-ember-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-ink-400">Location</p>
              <p class="text-lg font-semibold text-ink-900">{site.location}</p>
              <p class="text-sm text-ink-400">Reaching Canada wide to all provinces and territories</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="reveal">
        <div class="rounded-2xl border border-ink-100 bg-cream-50 p-8">
          <h3 class="text-display-sm font-semibold text-ink-900 mb-4">
            Send a Booking Inquiry
          </h3>
          <form
            name="booking-inquiry"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/thank-you/"
            class="space-y-4"
          >
            <input type="hidden" name="form-name" value="booking-inquiry" />
            <p class="hidden">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="name">Name *</label>
                <input type="text" id="name" name="name" required placeholder="Your name" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="organization">Organization</label>
                <input type="text" id="organization" name="organization" placeholder="School, company, or community" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="email">Email *</label>
                <input type="email" id="email" name="email" required placeholder="you@example.com" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="phone">Phone</label>
                <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="event-type">Event Type</label>
                <select id="event-type" name="event-type" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500">
                  <option>Keynote</option>
                  <option>Workshop</option>
                  <option>School presentation</option>
                  <option>Conference</option>
                  <option>Community event</option>
                  <option>Corporate event</option>
                  <option>Other</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="event-date">Event Date</label>
                <input type="date" id="event-date" name="event-date" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="location">Location</label>
                <input type="text" id="location" name="location" placeholder="City, province" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
              <div>
                <label class="block text-sm font-medium text-ink-700 mb-2" for="audience-size">Audience Size</label>
                <input type="text" id="audience-size" name="audience-size" placeholder="Approximate number" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-ink-700 mb-2" for="audience">Audience</label>
              <input type="text" id="audience" name="audience" placeholder="e.g. high school students, corporate leadership team" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
            </div>

            <div>
              <label class="block text-sm font-medium text-ink-700 mb-2" for="topic">Tell us about your event *</label>
              <textarea id="topic" name="topic" rows="4" required placeholder="Tell us about your event, goals, and audience..." class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500"></textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-ink-700 mb-2" for="budget">Budget (optional)</label>
              <input type="text" id="budget" name="budget" placeholder="Approximate budget range" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500" />
            </div>

            <div>
              <label class="block text-sm font-medium text-ink-700 mb-2" for="additional-info">Anything else?</label>
              <textarea id="additional-info" name="additional-info" rows="3" placeholder="Additional details" class="w-full rounded-lg border border-ink-200 bg-cream-100 px-4 py-3 text-ink-800 placeholder:text-ink-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-500"></textarea>
            </div>

            <button type="submit" class="w-full rounded-lg bg-ember-600 px-6 py-3.5 text-base font-semibold text-cream-50 transition-all duration-300 ease-out-expo hover:bg-ember-700 shadow-sm hover:shadow-md">
              Send Booking Inquiry
            </button>
          </form>
          <p class="mt-6 text-center text-sm text-ink-400">
            Prefer to talk? Call <a href={`tel:${site.phone}`} class="font-semibold text-ember-600 hover:text-ember-700">{site.phoneDisplay}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-200 py-24 md:py-32">
    <div class="container-content max-w-3xl">
      <h2 class="text-display-md font-semibold text-ink-900 mb-10 text-center">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="reveal group rounded-xl border border-ink-200 bg-cream-50 p-6 open:shadow-sm">
            <summary class="cursor-pointer list-none font-semibold text-ink-900 flex justify-between items-center gap-4">
              {faq.question}
              <svg class="w-5 h-5 flex-shrink-0 text-ember-600 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-4 text-ink-600 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

---
import '../styles/globals.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import { site } from '../config/site';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkipLink from '../components/SkipLink.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';

export interface LayoutProps {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Array<{ type: 'Person' | 'Organization' | 'FAQPage' | 'BlogPosting'; data: Record<string, any> }>;
}

const {
  title,
  description,
  canonical,
  image,
  noindex,
  type,
  jsonLd = [],
} = Astro.props as LayoutProps;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
      type={type}
    />

    <!-- Self-hosted variable fonts via Fontsource (imported in frontmatter below) -->

    <!-- JSON-LD structured data -->
    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Scroll reveal -->
    <script>
      import '../scripts/scroll-reveal.ts';
    </script>

    <!-- Booking form: save with fetch, then go to the Thank You page -->
    <script>
      import '../scripts/netlify-form.ts';
    </script>
  </head>

  <body class="min-h-screen bg-cream text-ink-800 font-body antialiased">
    <SkipLink />
    <Header />

    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>

    <Footer />
    <MobileStickyCTA />
  </body>
</html>

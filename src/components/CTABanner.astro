---
export interface CTABannerProps {
  title?: string;
  subtitle?: string;
  href?: string;
  label?: string;
}

import { site } from '../config/site';
import Button from './Button.astro';

const {
  title = 'Ready to Inspire Your Audience?',
  subtitle = 'If your agency, company, or community wants to book Carlin for an inspiring motivational speech or workshop, get in touch today.',
  href = site.bookingHref,
  label = 'Book Carlin',
} = Astro.props as CTABannerProps;
---

<section class="bg-ink-900 text-cream-50 py-20 md:py-28">
  <div class="container-content">
    <div class="flex flex-col items-center text-center gap-6 max-w-3xl mx-auto">
      <h2 class="text-display-sm font-semibold text-cream-50 text-balance">
        {title}
      </h2>
      <p class="text-lg text-ink-300 leading-relaxed text-pretty">
        {subtitle}
      </p>
      <Button href={href} variant="primary" size="lg" class="mt-4">
        {label}
      </Button>
    </div>
  </div>
</section>

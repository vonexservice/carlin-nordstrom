---
import Layout from '../../layouts/Layout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getCollection } from 'astro:content';

const title = 'Blog — Resilience, Leadership & Indigenous Wellness';
const description =
  'Insights and stories from Carlin Nordstrom — Indigenous leadership, resilience, youth development, and corporate keynote speaking.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

function readTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

const categories = ['All', ...Array.from(new Set(posts.flatMap((p) => p.data.tags)))];
---

<Layout title={title} description={description}>
  <section class="bg-ink-900 text-cream-50">
    <div class="container-content py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-400 mb-4">
        Insights on Resilience, Leadership &amp; Community
      </p>
      <h1 class="text-display-lg font-semibold text-cream-50 text-balance">
        Blog
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl text-pretty leading-relaxed">
        Practical reflections from Carlin Nordstrom on overcoming adversity, building confidence, leadership, Indigenous wellness, and supporting youth and communities.
      </p>
    </div>
  </section>

  <section class="border-b border-ink-100 bg-cream-50">
    <div class="container-content flex flex-wrap gap-2 py-6">
      {categories.map((cat) => (
        <span class="rounded-full border border-ink-200 px-4 py-1.5 text-sm font-medium text-ink-600">{cat}</span>
      ))}
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    {posts.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="reveal">
            <a
              href={`/blog/${post.slug}`}
              class="group block overflow-hidden rounded-2xl border border-ink-100 bg-cream-50 transition-all duration-300 hover:shadow-lg hover:border-ember-200"
            >
              <div class="aspect-[16/10] w-full bg-ink-100">
                <img
                  src={post.data.image ?? '/og-default.jpg'}
                  alt={post.data.title}
                  width="640"
                  height="400"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="p-6">
                {post.data.tags.length > 0 && (
                  <p class="text-sm font-semibold uppercase tracking-[0.1em] text-ember-600">
                    {post.data.tags[0]}
                  </p>
                )}
                <h2 class="mt-3 text-display-sm font-semibold text-ink-900 group-hover:text-ember-700 transition-colors">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-ink-400">
                  {post.data.publishDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })} · {readTime(post.body)} min read
                </p>
                <p class="mt-3 text-ink-500 leading-relaxed">
                  {post.data.description}
                </p>
                <span class="mt-4 inline-block text-sm font-semibold text-ember-600">
                  Read article &rarr;
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-display-md font-semibold text-ink-900 mb-6">
          New posts coming soon
        </h2>
        <p class="text-lg text-ink-500 leading-relaxed">
          Check back soon for new articles on leadership, resilience, and Indigenous wellness.
        </p>
      </div>
    )}
  </section>

  <CTABanner
    title="Bring These Messages to Your Audience"
    subtitle="Carlin turns these ideas into engaging keynotes and workshops for schools, communities, and organizations."
    label="Request Booking Information"
  />
</Layout>

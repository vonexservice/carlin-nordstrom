---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = 'Blog';
const description =
  'Insights and stories from Carlin Nordstrom — Indigenous leadership, motivation, hockey, youth development, and corporate keynote speaking.';

const posts = await getCollection('blog', ({ data }) => !data.draft);
---

<Layout title={title} description={description}>
  <section class="bg-ink-900 text-cream-50">
    <div class="container-content py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-400 mb-4">
        Insights on Leadership &amp; Resilience
      </p>
      <h1 class="text-display-lg font-semibold text-cream-50 text-balance">
        Blog
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl text-pretty leading-relaxed">
        Perspectives on Indigenous leadership, resilience, and personal growth from Carlin Nordstrom — an Indigenous motivational speaker and keynote speaker working with schools, communities, and organizations across Canada.
      </p>
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    {posts.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="reveal">
            <a
              href={`/blog/${post.slug}`}
              class="group block rounded-2xl border border-ink-100 bg-cream-50 p-6 transition-all duration-300 hover:shadow-lg hover:border-ember-200"
            >
              {post.data.tags.length > 0 && (
                <p class="text-sm font-semibold uppercase tracking-[0.1em] text-ember-600">
                  {post.data.tags[0]}
                </p>
              )}
              <h2 class="mt-3 text-display-sm font-semibold text-ink-900 group-hover:text-ember-700 transition-colors">
                {post.data.title}
              </h2>
              <p class="mt-3 text-ink-500 leading-relaxed">
                {post.data.description.startsWith('[PLACEHOLDER') ? 'Full post coming soon.' : post.data.description}
              </p>
              <span class="mt-4 inline-block text-sm font-semibold text-ember-600">
                Read more &rarr;
              </span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-display-md font-semibold text-ink-900 mb-6">
          Content coming in Phase 2
        </h2>
        <p class="text-lg text-ink-500 leading-relaxed">
          [PLACEHOLDER: blog posts will be added in Phase 2. Add Markdown files to src/content/blog/ to populate this page.]
        </p>
      </div>
    )}
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import SponsorLogos from '../components/SponsorLogos.astro';
import CTABanner from '../components/CTABanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';

const title = 'Kisik Youth Wellness';
const description =
  'Kisik Youth Wellness is a Saskatoon-based nonprofit founded by Carlin Nordstrom, running land-based wellness camps, educational tours, and motivational speaking for Indigenous and at-risk youth across Saskatchewan.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Kisik Youth Wellness',
    url: 'https://www.kisikyouthwellness.ca/',
    founder: { '@type': 'Person', name: 'Carlin Nordstrom', jobTitle: 'Executive Director' },
    description: 'Saskatoon-based nonprofit supporting Indigenous and at-risk youth through land-based wellness camps, educational tours, and motivational speaking.',
    areaServed: { '@type': 'AdministrativeArea', name: 'Saskatchewan, Canada' },
  },
];

const programs = [
  {
    title: 'Northern Land-Based Wellness Camps',
    text: 'Wellness camps in northern Saskatchewan for at-risk and Indigenous youth, combining wilderness training, land-based learning, cultural healing, fishing, archery, target shooting, physical fitness, and community building. Youth learn traditional Indigenous skills and build lasting friendships.',
  },
  {
    title: 'Future Possibilities Educational Tours',
    text: 'Educational tours for First Nations students from northern Saskatchewan to post-secondary and industry sites — including Sask Polytech, SIIT, the University of Saskatchewan, SaskPower, and other industrial companies — to show students the opportunities open to them and help them imagine their futures.',
  },
  {
    title: 'Motivational Speaking Events',
    text: 'Executive Director Carlin Nordstrom speaks to youth across Saskatchewan and Canada on setting goals, overcoming adversity, and handling failure — encouraging honest conversations about staying true to yourself.',
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="bg-cream-50">
    <div class="container-content py-20 md:py-28">
      <img
        src="/images/kisik-youth-wellness-logo.webp"
        alt="Kisik Youth Wellness"
        width="320"
        height="125"
        class="mb-6 h-20 w-auto object-contain"
      />
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-600 mb-4">
        Youth Wellness
      </p>
      <h1 class="text-display-lg font-semibold text-ink-900 text-balance">
        Kisik Youth Wellness
      </h1>
      <p class="mt-6 text-xl text-ink-600 max-w-2xl text-pretty leading-relaxed">
        A Saskatoon-based nonprofit founded by Carlin Nordstrom, Kisik Youth Wellness supports Indigenous and at-risk youth in building holistic well-being, physical fitness, and a thriving lifestyle — bridging land and city through wilderness training, life-skills learning, and mentorship.
      </p>
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-center">
      <div class="reveal">
        <SectionHeading
          eyebrow="Our Mission"
          title="Empowering the Next Generation"
        />
        <p class="mt-6 text-ink-600 leading-relaxed text-pretty">
          Kisik Youth Wellness has run youth wellness and land-based camps for 10 years. The work centres on mentorship, leadership, confidence, healthy living and community — giving Indigenous youth the tools and support to thrive.
        </p>
        <p class="mt-4 text-ink-600 leading-relaxed">
          As KISIK Youth Camp Leader and Director, Carlin brings years of experience working directly with Indigenous youth, combining his background as a professional athlete with his cultural heritage to create meaningful wellness programming.
        </p>
      </div>
      <div class="reveal">
        <img
          src="/images/kisik-gallery/deer-hunting.webp"
          alt="Youth deer hunting on a Kisik Youth Wellness land-based camp"
          width="800"
          height="550"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-2xl bg-ink-100 object-contain"
        />
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-16 md:py-20">
    <div class="container-content">
      <div class="reveal mx-auto max-w-3xl overflow-hidden rounded-2xl shadow-2xl">
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/i9azdb9EZI0"
            title="Kisik Youth Wellness"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-200 py-24 md:py-32">
    <div class="container-content">
      <SectionHeading
        eyebrow="Programs"
        title="What We Offer"
        align="center"
        class="reveal mb-16"
      />
      <div class="grid gap-8 md:grid-cols-3">
        {programs.map((p) => (
          <div class="reveal rounded-2xl border border-ink-200 bg-cream-50 p-8">
            <h3 class="text-display-sm font-semibold text-ink-900 mb-4">{p.title}</h3>
            <p class="text-ink-500 leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    <SectionHeading
      eyebrow="Life at Camp"
      title="Fishing, Hunting, and Outdoor Recreation"
      align="center"
      class="reveal mb-14"
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { src: '/images/kisik-gallery/ice-fishing.webp', alt: 'Youth ice fishing on a Kisik Youth Wellness land-based camp' },
        { src: '/images/kisik-gallery/fishing.webp', alt: 'Youth fishing on a Kisik Youth Wellness land-based camp' },
        { src: '/images/kisik-gallery/moose-hunting.webp', alt: 'Youth moose hunting on a Kisik Youth Wellness land-based camp' },
        { src: '/images/kisik-gallery/boating-outdoors.webp', alt: 'Youth boating and enjoying the outdoors at a Kisik Youth Wellness camp' },
      ].map((photo) => (
        <img
          src={photo.src}
          alt={photo.alt}
          width="800"
          height="550"
          loading="lazy"
          class="reveal aspect-[4/3] w-full rounded-2xl bg-ink-100 object-contain"
        />
      ))}
    </div>
  </section>

  <section class="container-content py-16">
    <div class="reveal text-center">
      <SectionHeading eyebrow="Our Sponsors" title="Supported By" align="center" class="mb-10" />
      <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-10">
        <SponsorLogos />
      </div>
    </div>
  </section>

  <section class="container-content py-24 md:py-32 max-w-3xl text-center">
    <div class="reveal">
      <SectionHeading eyebrow="What Parents Say" title="Real impact, in their own words" align="center" class="mb-8" />
      <p class="text-ink-600 leading-relaxed text-pretty">
        Parents of camp participants describe mentorship that has changed the direction of their children's lives — one parent shared that their child now plans to attend every year and eventually become a counsellor themselves. Read more on the official <a href="https://www.kisikyouthwellness.ca/" target="_blank" rel="noopener noreferrer" class="font-semibold text-ember-600 hover:text-ember-700">Kisik Youth Wellness website</a>.
      </p>
    </div>
  </section>

  <section class="bg-cream-200 py-24 md:py-32">
    <div class="container-content">
      <SectionHeading
        eyebrow="In Action"
        title="Confidence-Building and Mentorship"
        align="center"
        class="reveal mb-14"
      />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <img
          src="/images/kisik-gallery/confidence-activity.webp"
          alt="A Kisik Youth Wellness confidence-building activity"
          width="800"
          height="550"
          loading="lazy"
          class="reveal aspect-[4/3] w-full rounded-2xl bg-cream-50 object-contain"
        />
        <img
          src="/images/kisik-gallery/youth-mentorship.webp"
          alt="Carlin leading a youth discussion and mentorship session at Kisik Youth Wellness"
          width="800"
          height="550"
          loading="lazy"
          class="reveal aspect-[4/3] w-full rounded-2xl bg-cream-50 object-contain"
        />
        <img
          src="/images/kisik-hockey-development.webp"
          alt="Carlin coaching youth through Kisik Hockey Development"
          width="1080"
          height="1075"
          loading="lazy"
          class="reveal aspect-[4/3] w-full rounded-2xl bg-cream-50 object-contain"
        />
        <img
          src="/images/kisik-presentation.webp"
          alt="Carlin presenting to youth at a Kisik Youth Wellness event"
          width="1500"
          height="2000"
          loading="lazy"
          class="reveal aspect-[4/3] w-full rounded-2xl bg-cream-50 object-contain"
        />
      </div>
    </div>
  </section>

  <CTABanner
    title="Get Involved with Kisik Youth Wellness"
    subtitle="If your school, agency, or community wants to bring Kisik Youth Wellness programming to your students, get in touch to discuss availability."
    label="Get in Touch"
  />
</Layout>

---
export interface CTABannerProps {
  title?: string;
  subtitle?: string;
  href?: string;
  label?: string;
  showOneSheet?: boolean;
}

import { site } from '../config/site';
import Button from './Button.astro';

const {
  title = 'Ready to Inspire Your Audience?',
  subtitle = 'If your agency, company, or community wants to book Carlin for an inspiring motivational speech or workshop, get in touch today.',
  href = site.bookingHref,
  label = 'Check Speaking Availability',
  showOneSheet = false,
} = Astro.props as CTABannerProps;
---

<section class="bg-ink-900 text-cream-50 py-20 md:py-28">
  <div class="container-content">
    <div class="flex flex-col items-center text-center gap-6 max-w-3xl mx-auto">
      <h2 class="text-display-sm font-semibold text-cream-50 text-balance">
        {title}
      </h2>
      <p class="text-lg text-ink-300 leading-relaxed text-pretty">
        {subtitle}
      </p>
      <div class="mt-4 flex flex-col gap-4 sm:flex-row">
        <Button href={href} variant="primary" size="lg">
          {label}
        </Button>
        {showOneSheet && (
          <Button href="/carlin-nordstrom-speaker-one-sheet.pdf" variant="outline" size="lg" class="border-ink-600 text-cream-50 hover:border-ember-400 hover:text-ember-400">
            Download Speaker One-Sheet
          </Button>
        )}
      </div>
    </div>
  </div>
</section>

---

<footer class="bg-ink-900 text-cream-100">
  <div class="container-content py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-3 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a
          href="/"
          class="inline-flex transition-opacity hover:opacity-80"
          aria-label={`${site.name} — Home`}
        >
          <img src="/images/CN-Believe-logo-1.webp" alt="Believe CN" width="112" height="56" class="h-14 w-auto object-contain" />
        </a>
        <p class="mt-4 max-w-md text-ink-300 leading-relaxed">
          A leading Indigenous motivational speaker located in Saskatchewan, Canada. Member of Poundmaker First Nation, former professional hockey player, and founder of Kisik Youth Wellness and Kisik Pathways to Success. Speaking across Canada.
        </p>

        <!-- Social -->
        <div class="mt-6 flex gap-3">
          {site.social.map((s) => (
            <a
              href={s.href}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-ink-800 text-ink-300 hover:bg-ember-600 hover:text-cream-50 transition-all duration-300"
              aria-label={s.label}
              rel="noopener noreferrer"
              {...(s.href !== '#' ? { target: '_blank' } : {})}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={socialIcons[s.icon] || ''} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Nav -->
      <nav aria-label="Footer navigation">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-400 mb-4">
          Explore
        </h2>
        <ul class="flex flex-col gap-2">
          {site.footerNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink-300 hover:text-ember-400 transition-colors duration-200"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Booking CTA -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-400 mb-4">
          Get in Touch
        </h2>
        <p class="text-ink-300 mb-4">
          If your agency, company, or community wants to book Carlin for an inspiring motivational speech or workshop, get in touch.
        </p>
        <a
          href={site.bookingHref}
          class="inline-flex items-center justify-center font-semibold transition-all duration-300 ease-out-expo rounded-lg bg-ember-600 text-cream-50 hover:bg-ember-700 shadow-sm hover:shadow-md px-6 py-3 text-base"
        >
          Book Carlin
        </a>
        <p class="mt-4 text-sm text-ink-400">
          {site.location}<br />
          <a href={`tel:${site.phone}`} class="hover:text-ember-400 transition-colors">{site.phoneDisplay}</a>
          {!site.email.startsWith('[PLACEHOLDER') && (
            <>
              <br />
              <a href={`mailto:${site.email}`} class="hover:text-ember-400 transition-colors">{site.email}</a>
            </>
          )}
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-ink-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-ink-400">
        &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
      </p>
      <p class="text-sm text-ink-400">
        {/* DRAFT — please confirm exact wording with Carlin before publishing */}
        We acknowledge we are on Treaty 6 Territory, the traditional and ancestral homeland of the Cree, Saulteaux, Dene, Dakota, Nakota, Lakota, and Métis peoples.
      </p>
    </div>
  </div>
</footer>

---
import { site } from '../config/site';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-ink-100/80 bg-cream-50/95 backdrop-blur-md transition-shadow"
>
  <div class="container-content">
    <div class="flex h-20 items-center justify-between gap-4">
      <!-- Logo / Name -->
      <a
        href="/"
        class="flex items-center gap-3 transition-opacity hover:opacity-80"
        aria-label={`${site.name} — Home`}
      >
        <img src="/images/CN-Believe-logo-1.webp" alt="Believe CN" width="192" height="56" class="h-14 w-auto object-contain" />
        <span class="sr-only">{site.name}</span>
      </a>

      <!-- Desktop Nav -->
      <nav
        class="hidden lg:flex items-center gap-1"
        aria-label="Primary navigation"
      >
        {site.nav.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-2 text-sm font-medium rounded-md transition-colors duration-200 ${
              isActive(item.href)
                ? 'text-ember-700'
                : 'text-ink-600 hover:text-ember-700 hover:bg-ink-50'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Book Carlin button (desktop) -->
      <div class="hidden lg:block">
        <Button href={site.bookingHref} variant="primary" size="sm">
          Book Carlin
        </Button>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden flex flex-col items-center justify-center w-10 h-10 rounded-md text-ink-800 hover:bg-ink-50 transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-ink-100 bg-cream-50"
  >
    <nav class="container-content py-4" aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class={`block px-4 py-3 text-base font-medium rounded-lg transition-colors ${
                isActive(item.href)
                  ? 'text-ember-700 bg-ember-50'
                  : 'text-ink-700 hover:bg-ink-50'
              }`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="pt-2">
          <Button href={site.bookingHref} variant="primary" size="md" class="w-full">
            Book Carlin
          </Button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        toggle.focus();
      }
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      });
    });
  }
</script>

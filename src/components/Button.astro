---
export interface ButtonProps {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'outline-light' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props as ButtonProps;

const base =
  'inline-flex items-center justify-center font-semibold transition-all duration-300 ease-out-expo rounded-lg focus-visible:outline-2 focus-visible:outline-offset-3 disabled:opacity-50 disabled:pointer-events-none whitespace-nowrap';

const variants = {
  primary:
    'bg-ember-600 text-cream-50 hover:bg-ember-700 shadow-sm hover:shadow-md',
  secondary:
    'bg-ink-900 text-cream-50 hover:bg-ink-800 shadow-sm hover:shadow-md',
  outline:
    'border-2 border-ink-300 text-ink-800 hover:border-ember-500 hover:text-ember-700',
  // For dark backgrounds. A separate variant, because adding text-cream-50
  // on top of `outline` loses to text-ink-800 and leaves dark text on dark.
  'outline-light':
    'border-2 border-ink-600 text-cream-50 hover:border-ember-400 hover:text-ember-400',
  ghost:
    'text-ink-700 hover:text-ember-700 hover:bg-ember-50',
};

const sizes = {
  sm: 'text-sm px-4 py-2',
  md: 'text-base px-6 py-3',
  lg: 'text-lg px-8 py-4',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} {...rest}>
    <slot />
  </button>
)}

---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
import { getCollection } from 'astro:content';

const title = 'Indigenous Keynote Speaker Topics';
const description =
  'Keynote presentations by Carlin Nordstrom on resilience, leadership, and belief — for schools, corporations, and conferences across Canada.';

const keynoteTopics = (await getCollection('keynotes')).sort(
  (a, b) => a.data.order - b.data.order
);

const keynotePhotos: Record<string, { src: string; alt: string; width: number; height: number }> = {
  'Overcoming Adversity: Turning Setbacks Into Strength': {
    src: '/images/carlin-keynote-stage.webp',
    alt: 'Carlin speaking on stage — Overcoming Adversity',
    width: 590,
    height: 390,
  },
  'Lead Like a Teammate: Leadership, Accountability & Team Culture': {
    src: '/images/carlin-gym-assembly.webp',
    alt: 'Carlin speaking to a full assembly — Lead Like a Teammate',
    width: 843,
    height: 632,
  },
  'Build Belief: Goal-Setting, Confidence & Taking Ownership': {
    src: '/images/kisik-presentation.webp',
    alt: 'Carlin presenting his hockey journey — Build Belief',
    width: 1500,
    height: 2000,
  },
};
const fallbackKeynotePhoto = keynotePhotos['Overcoming Adversity: Turning Setbacks Into Strength'];

const eventDetails = [
  { label: 'Formats', text: 'Keynote, workshop, school presentation, virtual session' },
  { label: 'Typical length', text: '45–60 minute keynote; customizable' },
  { label: 'Audiences', text: 'Students, educators, corporate teams, community organizations, conferences' },
  { label: 'Locations', text: 'Saskatchewan-based; available across Canada' },
  { label: 'AV needs', text: 'Microphone, screen/projector if slides or video are used' },
  { label: 'Customization', text: "Carlin discusses event goals, audience, and theme before the presentation" },
];

const faqs = [
  { q: "How long is Carlin's keynote?", a: 'A typical keynote runs 45–60 minutes, and can be adjusted to fit your event schedule.' },
  { q: 'Does Carlin speak virtually?', a: 'Yes, virtual sessions are available in addition to in-person keynotes and workshops.' },
  { q: 'Can presentations be customized?', a: "Yes. Carlin discusses your event's goals, audience, and theme before the presentation to tailor the message." },
  { q: 'What types of organizations does he work with?', a: 'Schools, First Nations communities, corporations, conferences, sports organizations, and community groups across Canada.' },
  { q: 'How far in advance should we book?', a: 'Earlier is better for securing a preferred date, but reach out even for shorter-notice events — availability varies.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd.map((data) => ({ type: 'FAQPage', data }))}>
  <section class="bg-ink-900 text-cream-50">
    <div class="container-content py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-400 mb-4">
        Keynote Speaking That Moves People Forward
      </p>
      <h1 class="text-display-lg font-semibold text-cream-50 text-balance">
        Indigenous Keynote Speaker Topics
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl text-pretty leading-relaxed">
        Carlin Nordstrom delivers engaging keynotes on resilience, leadership, belief, and overcoming adversity. Drawing on his experience as an Indigenous athlete, former professional hockey player, and youth mentor, he helps audiences turn challenges into momentum.
      </p>
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    <div class="flex flex-col gap-20">
      {keynoteTopics.map((k, i) => (
        <div class={`reveal grid gap-12 lg:grid-cols-2 lg:gap-20 items-center ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.15em] text-ember-600 mb-3">
              Keynote {i + 1}
            </p>
            <h2 class="text-display-md font-semibold text-ink-900 mb-4 text-balance">
              {k.data.title}
            </h2>
            {k.data.audience && (
              <p class="mb-5 text-sm font-semibold text-ink-500">Best for: <span class="text-ink-700">{k.data.audience}</span></p>
            )}
            <p class="text-ink-600 leading-relaxed text-pretty">
              {k.data.description}
            </p>
            <p class="mt-6 text-sm font-semibold uppercase tracking-[0.1em] text-ink-500">Audiences will learn:</p>
            <ul class="mt-3 space-y-3">
              {k.data.outcomes.map((outcome) => (
                <li class="flex gap-3 items-start">
                  <svg class="w-5 h-5 text-ember-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span class="text-ink-700">{outcome}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <Button href="/contact" variant="primary" size="md">
                Check Availability for This Topic
              </Button>
            </div>
          </div>
          <div>
            <img
              src={(keynotePhotos[k.data.title] ?? fallbackKeynotePhoto).src}
              alt={(keynotePhotos[k.data.title] ?? fallbackKeynotePhoto).alt}
              width={(keynotePhotos[k.data.title] ?? fallbackKeynotePhoto).width}
              height={(keynotePhotos[k.data.title] ?? fallbackKeynotePhoto).height}
              loading="lazy"
              class="aspect-[4/3] w-full rounded-2xl object-cover"
            />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Event Details -->
  <section class="bg-cream-200 py-24 md:py-32">
    <div class="container-content">
      <SectionHeading eyebrow="Keynote Formats & Booking Details" title="What to know before you book" align="center" class="reveal mb-14" />
      <dl class="mx-auto grid max-w-4xl gap-8 sm:grid-cols-2">
        {eventDetails.map((item) => (
          <div class="reveal">
            <dt class="text-sm font-semibold uppercase tracking-[0.1em] text-ember-600">{item.label}</dt>
            <dd class="mt-2 text-ink-700 leading-relaxed">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-content py-24 md:py-32">
    <SectionHeading eyebrow="Common Questions" title="Frequently asked questions" align="center" class="reveal mb-14" />
    <div class="mx-auto max-w-3xl divide-y divide-ink-200">
      {faqs.map((faq) => (
        <div class="reveal py-6">
          <h3 class="text-lg font-semibold text-ink-900">{faq.q}</h3>
          <p class="mt-2 text-ink-600 leading-relaxed">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>

  <CTABanner
    title="Not sure which keynote fits your event?"
    subtitle="Tell us about your audience and goals, and we'll recommend the best fit."
    label="Request Booking Information"
    showOneSheet
  />
</Layout>

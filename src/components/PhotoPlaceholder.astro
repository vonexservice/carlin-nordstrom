---
export interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<div class={`aspect-[4/3] rounded-2xl bg-ink-100 flex flex-col items-center justify-center gap-3 text-ink-400 ${className}`} title={`Placeholder — ${label}`}>
  <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <circle cx="9" cy="10.5" r="1.75" />
    <path d="m4.5 17 4.5-4.5a2 2 0 0 1 2.8 0L15 15.5" />
    <path d="m14 15-1-1a2 2 0 0 1 2.8 0L19.5 17" />
  </svg>
  <span class="text-xs font-medium uppercase tracking-wide">Photo coming soon</span>
</div>
